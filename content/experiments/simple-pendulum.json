  "hints": {
    "len-1": {
      "rung": 1,
      "text": "The length is not just the string."
    },
    "len-2": {
      "rung": 2,
      "text": "It runs to the centre of the bob: string + radius."
    },
    "len-3": {
      "rung": 3,
      "text": "Measure the string and add the bob's radius (1.5 cm)."
    },
    "rel-1": {
      "rung": 1,
      "text": "Big swings change the period."
    },
    "rel-2": {
      "rung": 2,
      "text": "Set the release angle under 10°."
    },
    "rel-3": {
      "rung": 3,
      "text": "Set about 5°, then release."
    },
    "time-1": {
      "rung": 1,
      "text": "One oscillation is there and back."
    },
    "time-2": {
      "rung": 2,
      "text": "Start and stop as the bob passes the lowest point: it moves fastest there, so the moment is sharp."
    },
    "time-3": {
      "rung": 3,
      "text": "Count \"zero\" as you start, stop on \"twenty\", and divide the time by 20."
    },
    "five-1": {
      "rung": 1,
      "text": "Spread the lengths out."
    },
    "five-2": {
      "rung": 2,
      "text": "Try about 0.3, 0.45, 0.6, 0.75 and 0.9 m."
    },
    "five-3": {
      "rung": 3,
      "text": "Measure L and time 20 swings for each."
    },
    "g-1": {
      "rung": 1,
      "text": "T² = (4π²/g) L."
    },
    "g-2": {
      "rung": 2,
      "text": "Gradient = T² / L for your best-fit line."
    },
    "g-3": {
      "rung": 3,
      "text": "g = 4π² ÷ gradient. It should be close to 9.8 m/s²."
    }
  },
  "observations": {
    "whatHappened": "Longer pendulums swung more slowly. T² against L was a straight line through the origin, and its gradient gave g close to 9.8 m/s².",
    "why": "For small swings the period depends only on length and gravity: T = 2π√(L/g). Squaring gives T² = (4π²/g) L, a straight line. Timing 20 swings divides your reaction-time error by 20; small angles keep the formula accurate.",
    "equationLatex": "T = 2\\pi\\sqrt{\\frac{L}{g}} \\qquad T^2 = \\frac{4\\pi^2}{g}L",
    "realWorld": [
      "Pendulum clocks",
      "Swings in a playground",
      "Measuring g at different places on Earth"
    ],
    "prompts": [
      {
        "id": "q1",
        "question": "Doubling the mass of the bob makes the period…",
        "choices": [
          "double",
          "halve",
          "stay the same",
          "four times longer"
        ],
        "answer": 2,
        "explain": "Mass does not appear in T = 2π√(L/g)."
      },
      {
        "id": "q2",
        "question": "To double the period you must make the length…",
        "choices": [
          "twice as long",
          "four times as long",
          "half as long",
          "√2 times as long"
        ],
        "answer": 1,
        "explain": "T ∝ √L, so 4× the length doubles T."
      },
      {
        "id": "q3",
        "question": "Why time 20 oscillations, not 1?",
        "choices": [
          "It is more fun",
          "Your reaction-time error is spread over 20 swings",
          "One swing is too fast to see",
          "The first swing is always wrong"
        ],
        "answer": 1,
        "explain": "The same ~0.2 s error becomes 0.01 s per swing."
      }
    ]
  },
