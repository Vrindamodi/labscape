        "id": "q-water",
        "question": "What colour did universal indicator turn in distilled water?",
        "choices": [
          "Red",
          "Green",
          "Purple",
          "Colourless"
        ],
        "answer": 1,
        "explain": "Pure water is neutral, pH 7, which is green on the universal indicator chart."
      },
      {
        "id": "q-litmus",
        "question": "Litmus turned blue in tube 5. That tells you the liquid is...",
        "choices": [
          "Acidic",
          "Neutral",
          "Alkaline",
          "A salt"
        ],
        "answer": 2,
        "explain": "Litmus is blue in alkalis and red in acids."
      }
    ]
  },
