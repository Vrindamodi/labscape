  "hints": {
    "fill-1": { "rung": 1, "text": "What could go wrong if you pour quickly into a narrow tube?" },
    "fill-2": { "rung": 2, "text": "Tilt the bottle only a little so the pour-rate gauge stays green, below 6 mL/s." },
