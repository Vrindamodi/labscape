    "rough-1": { "rung": 1, "text": "This run only needs to find roughly where the end point is." },
    "rough-2": { "rung": 2, "text": "Add about 1 mL, swirl, and repeat until the pink stops fading." },
    "rough-3": { "rung": 3, "text": "Watch: add, swirl, add, swirl." },
    "acc-1": { "rung": 1, "text": "What happens if you add too much at once near the end point?" },
    "acc-2": { "rung": 2, "text": "Slow down! Near the end point add one drop at a time with the stopcock, swirling after each drop." },
    "acc-3": { "rung": 3, "text": "Watch the last millilitre go in drop by drop." }
  },
  "observations": {
    "whatHappened": "Each drop of alkali flashed pink where it landed and faded when you swirled. At the end point a single drop turned the whole flask a faint pink that lasted.",
    "why": "H⁺ ions from the acid and OH⁻ ions from the alkali combine to make water. While acid is left over, any pink is neutralised as soon as it mixes in. When the moles of NaOH added equal the moles of HCl in the flask, the next drop leaves the solution slightly alkaline and phenolphthalein turns pink above about pH 8.2.",
    "equationLatex": "\\mathrm{HCl(aq) + NaOH(aq) \\longrightarrow NaCl(aq) + H_2O(l)}",
    "realWorld": ["Checking acidity in fruit juice and wine", "Quality control in pharmaceuticals", "Measuring water hardness"],
    "prompts": [
      { "id": "q-flash", "question": "Why did a pink flash appear where each drop landed, then fade when you swirled?", "choices": ["Locally there was excess alkali until it mixed with the acid", "The indicator evaporated", "The flask warmed up", "Light reflected off the drop"], "answer": 0, "explain": "Right where it lands, the drop of NaOH is in excess, so the indicator turns pink. Swirling mixes it into the acid, which neutralises it." },
      { "id": "q-moles", "question": "At the end point, the moles of NaOH added are...", "choices": ["Half the moles of HCl", "Equal to the moles of HCl", "Twice the moles of HCl", "Equal to the volume of HCl"], "answer": 1, "explain": "HCl and NaOH react 1 : 1, so at equivalence the moles are equal." },
      { "id": "q-conc", "question": "Your titre was about 10.0 mL of 0.100 M NaOH for 10.00 mL of HCl. The acid concentration is closest to...", "choices": ["0.050 M", "0.100 M", "0.200 M", "1.00 M"], "answer": 1, "explain": "c(HCl) = 0.100 × 10.0 / 10.00 = 0.100 M." }
    ]
  },
