        "id": "q1",
        "question": "With no air resistance, which angle gives the greatest range?",
        "choices": [
          "30°",
          "45°",
          "60°",
          "90°"
        ],
        "answer": 1,
        "explain": "sin 2θ is largest (1) when 2θ = 90°."
      },
      {
        "id": "q2",
        "question": "During the flight (no drag), the horizontal velocity…",
        "choices": [
          "increases",
          "decreases",
          "stays the same",
          "becomes zero at the top"
        ],
        "answer": 2,
        "explain": "No horizontal force acts, so the horizontal velocity is constant."
      },
      {
        "id": "q3",
        "question": "Air resistance makes the range…",
        "choices": [
          "longer",
          "shorter",
          "unchanged",
          "longer for heavy balls only"
        ],
        "answer": 1,
        "explain": "Drag opposes the motion and removes energy."
      }
    ]
  },
