    {
      "id": "why-dropwise",
      "type": "multiple_choice",
      "prompt": "Why is the NaOH added dropwise near the end point?",
      "conceptIds": [
        "burette-technique",
        "end-point"
      ],
      "options": [
        {
          "id": "a",
          "text": "To save sodium hydroxide"
        },
        {
          "id": "b",
          "text": "So you do not overshoot: one drop can change the colour"
        },
        {
          "id": "c",
          "text": "Because the burette tap is stiff"
        },
        {
          "id": "d",
          "text": "To keep the flask cool"
        }
      ],
      "multi": false,
      "answer": [
        1
      ],
      "explanation": "Near the end point a single drop turns the indicator. Adding quickly would run past it, so the titre would be too big.",
      "status": "approved",
      "source": "author"
    },
    {
      "id": "swirl",
      "type": "true_false",
      "prompt": "You should swirl the conical flask after each addition.",
      "conceptIds": [
        "burette-technique"
      ],
      "answer": true,
      "explanation": "Swirling mixes the base through the acid, so the colour you see is the colour of the whole mixture, not just where the drop landed.",
      "status": "approved",
      "source": "author"
    },
    {
      "id": "calc",
      "type": "numerical",
      "prompt": "25.0 mL of HCl needs 20.0 mL of 0.100 M NaOH to neutralise it. What is the concentration of the HCl?",
      "conceptIds": [
        "titration-calc"
      ],
      "unit": "mol/L",
      "answer": 0.08,
      "tolerance": {
        "abs": 0.002
      },
      "acceptUnits": [
        "mol/L",
        "M",
        "mol/dm3",
        "mol dm-3"
      ],
      "explanation": "Moles NaOH = 0.100 × 0.0200 = 0.00200 mol. HCl reacts 1:1, so c = 0.00200 ÷ 0.0250 = 0.0800 mol/L.",
      "status": "approved",
      "source": "author"
    },
