      "id": "procedure",
      "type": "arrange_steps",
      "prompt": "Put the titration steps in order.",
      "conceptIds": [
        "burette-technique"
      ],
      "steps": [
        {
          "id": "s1",
          "text": "Rinse the burette with a little NaOH"
        },
        {
          "id": "s2",
          "text": "Fill the burette and clear the air bubble in the jet"
        },
        {
          "id": "s3",
          "text": "Pipette 25.0 mL of acid into the flask and add indicator"
        },
        {
          "id": "s4",
          "text": "Run in NaOH quickly, then dropwise near the end point"
        },
        {
          "id": "s5",
          "text": "Record the burette reading when one drop turns it pale pink"
        }
      ],
      "answer": [
        "s1",
        "s2",
        "s3",
        "s4",
        "s5"
      ],
      "explanation": "Rinsing with the solution stops water diluting it; the bubble must go before the first reading; the end point is the first permanent pale pink.",
      "status": "approved",
      "source": "author"
