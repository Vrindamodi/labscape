  "questions": [
    {
      "id": "calc-a",
      "type": "numerical",
      "prompt": "A resultant force of 1.2 N acts on a trolley of total mass 0.60 kg. What is its acceleration?",
      "conceptIds": [
        "f-ma"
      ],
      "unit": "m/s²",
      "answer": 2,
      "tolerance": {
        "abs": 0.05
      },
      "acceptUnits": [
        "m/s²",
        "m/s^2",
        "ms^-2",
        "m s^-2"
      ],
      "explanation": "a = F ÷ m = 1.2 ÷ 0.60 = 2.0 m/s².",
      "status": "approved",
      "source": "author"
    },
    {
      "id": "double-f",
      "type": "predict_outcome",
      "prompt": "The total mass stays the same and the pulling force is doubled. What happens to the acceleration?",
      "conceptIds": [
        "f-ma"
      ],
      "options": [
        {
          "id": "a",
          "text": "It halves"
        },
        {
          "id": "b",
          "text": "It stays the same"
        },
        {
          "id": "c",
          "text": "It doubles"
        },
        {
          "id": "d",
          "text": "It quadruples"
        }
      ],
      "answer": [
        2
      ],
      "explanation": "a = F/m: with m fixed, a is directly proportional to F.",
      "status": "approved",
      "source": "author"
    },
    {
