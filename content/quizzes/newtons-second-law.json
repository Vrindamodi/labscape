    {
      "id": "gates",
      "type": "numerical",
      "prompt": "A 10 cm card takes 0.20 s to pass gate 1 and 0.10 s to pass gate 2. The gates are 0.50 m apart. What is the acceleration?",
      "conceptIds": [
        "light-gates"
      ],
      "unit": "m/s²",
      "answer": 0.75,
      "tolerance": {
        "abs": 0.02
      },
      "acceptUnits": [
        "m/s²",
        "m/s^2",
        "ms^-2",
        "m s^-2"
      ],
      "explanation": "v₁ = 0.10 ÷ 0.20 = 0.50 m/s, v₂ = 0.10 ÷ 0.10 = 1.0 m/s. a = (1.0² − 0.50²) ÷ (2 × 0.50) = 0.75 m/s².",
      "status": "approved",
      "source": "author"
    },
