# Copy to .env (never commit .env).

# --- Database -------------------------------------------------------------
# Local (docker compose up -d):
DATABASE_URL=jdbc:postgresql://localhost:5432/labscape
DATABASE_USERNAME=labscape
DATABASE_PASSWORD=labscape
# Neon: copy the connection details from the Neon console (use the pooled host for the app).
# DATABASE_URL=jdbc:postgresql://<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# DATABASE_USERNAME=<neon-role>
# DATABASE_PASSWORD=<neon-password>
# Flyway migrations should use the direct (non-pooled) host:
# FLYWAY_URL=jdbc:postgresql://<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

# --- Redis ----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Web ------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:5173
# Optional: run a second web + API pair beside the default one (read by apps/web/vite.config.ts,
# from the shell or apps/web/.env.<mode>).
# LABSCAPE_WEB_PORT=5174
# LABSCAPE_API_URL=http://localhost:8081
